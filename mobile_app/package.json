{
  "name": "gabla-mobile-app",
  "private": true,
  "version": "1.0.0",
  "description": "Android and iOS shell for the Gabla storefront (Capacitor). The web app itself lives in ../public_app.",
  "scripts": {
    "build:web": "VITE_API_URL=${VITE_API_URL:-https://sidra-api.fly.dev/api/v1} VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID:-478189678916-l0t6k527ok7rra3p7tcpq8445suh46qj.apps.googleusercontent.com} npm --prefix ../public_app run build -- --mode native --outDir ../mobile_app/www --emptyOutDir",
    "assets": "capacitor-assets generate --iconBackgroundColor '#0B2046' --splashBackgroundColor '#0B2046'",
    "sync": "npm run build:web && cap sync",
    "android:apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run sync && open ios/App/App.xcworkspace"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.5.17"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3"
  }
}
